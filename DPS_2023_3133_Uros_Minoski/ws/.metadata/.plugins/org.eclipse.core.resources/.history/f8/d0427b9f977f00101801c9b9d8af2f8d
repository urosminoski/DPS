	// Begin filtering the data
    while (fread(temp, sizeof(Int8), NUM_DATA*2, xin_file) == (NUM_DATA*2))
    {
        for (k=0, i=0; i<NUM_DATA; i++)
        {
            xin[i] = (temp[k]&0xFF)|(temp[k+1]<<8);
            k += 2;
        }
        // Filter the data x and save output y
